#!/usr/bin/env bash
#MISE description="Install the NetworkManager dispatcher that toggles wifi power save on AC/battery"
#MISE sources=["{{env.HOME}}/.config/mise/tasks/nm-wifi-powersave"]
set -euo pipefail

[ "$(uname)" = "Linux" ] || exit 0

if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
	echo "nm-wifi-powersave: no passwordless sudo and not interactive; skipping."
	echo "Run 'mise run nm-wifi-powersave' from a terminal."
	exit 1
fi

DEST=/etc/NetworkManager/dispatcher.d/99-wifi-powersave

echo "==> Installing NM dispatcher: wifi power save toggle on AC/battery"

sudo tee "$DEST" >/dev/null <<'DISPATCHER'
#!/bin/sh
wifi_dev=$(iw dev 2>/dev/null | awk '/Interface/{print $2; exit}')
[ -n "$wifi_dev" ] || exit 0
[ -d "/sys/class/net/$wifi_dev" ] || exit 0

if [ "$(cat /sys/class/power_supply/AC/online 2>/dev/null)" = "1" ]; then
    iw dev "$wifi_dev" set power_save off
else
    iw dev "$wifi_dev" set power_save on
fi
DISPATCHER

sudo chmod 755 "$DEST"

echo "==> Running dispatcher immediately"
sudo "$DEST"
