#!/usr/bin/env bash
#MISE description="Stop the pre-mise mempalace/mute agents and units so the dev.mise.* ones own the ports"
set -euo pipefail

# Two qdrants would fight over 6333. Safe to re-run: missing jobs are ignored.
# Runs as a pre-dotfiles hook; works by label/unit name, so it still works when
# a plain `mise dot apply` already deleted the old files.
case "$(uname)" in
Darwin)
	domain="gui/$(id -u)"
	for label in com.pedro.qdrant com.pedro.mempalace-hub com.pedro.mempalace-wings com.pedro.mute-at-2100 com.pedro.unmute-at-0900; do
		if launchctl print "${domain}/${label}" >/dev/null 2>&1; then
			echo "==> booting out ${label}"
			launchctl bootout "${domain}/${label}" || true
		fi
	done
	;;
Linux)
	changed=0
	for unit in mempalace-wings.timer mempalace-hub.service qdrant.service mempalace-wings.service; do
		if systemctl --user is-active --quiet "${unit}" 2>/dev/null; then
			echo "==> stopping ${unit}"
			systemctl --user stop "${unit}" || true
		fi
		# disable needs the unit file, which may already be gone; drop the links directly.
		for link in "${HOME}"/.config/systemd/user/*.wants/"${unit}"; do
			[ -L "${link}" ] || continue
			echo "==> removing ${link}"
			rm -f "${link}"
			changed=1
		done
	done
	if [ "${changed}" -eq 1 ]; then
		systemctl --user daemon-reload
	fi
	;;
esac
