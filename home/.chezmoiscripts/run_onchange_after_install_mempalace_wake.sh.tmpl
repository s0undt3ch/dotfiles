{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# vim: set ft=sh:
set -euo pipefail

# Root LaunchDaemon that keeps a one-off `pmset schedule wake` booked for the
# next 02:58, so the 03:00 mempalace-wings run finds the Mac awake.
# `pmset repeat` would do it in one line, but it holds a single repeating wake
# and obsidiary already owns that. `pmset schedule` takes a two-digit year but
# `pmset -g sched` prints four, hence %y to book and %Y to check.

label=com.pedro.mempalace-wake
plist="/Library/LaunchDaemons/${label}.plist"

if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
    echo "${label}: no passwordless sudo and not interactive; skipping."
    exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "${tmp}"' EXIT
cat >"${tmp}" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.pedro.mempalace-wake</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>if [ "$(date +%H%M)" -lt 0258 ]; then o=+0d; else o=+1d; fi; pmset -g sched | grep -q "wake at $(date -v$o +%m/%d/%Y) 02:58:00" || pmset schedule wake "$(date -v$o +%m/%d/%y) 02:58:00"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>5</integer>
	</dict>
</dict>
</plist>
PLIST

echo "==> installing ${label} (sudo)"
sudo launchctl bootout "system/${label}" 2>/dev/null || true
sudo install -m 644 -o root -g wheel "${tmp}" "${plist}"
sudo launchctl bootstrap system "${plist}"
sleep 1
pmset -g sched | grep -F '02:58:00' | sed -E 's#([0-9]{2})/([0-9]{2})/([0-9]{4})#\3/\1/\2#' ||
    echo "${label}: no 02:58 wake booked yet." >&2
{{ end -}}
