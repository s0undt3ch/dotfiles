#!/usr/bin/env bash
# vim: set ft=sh:
set -euo pipefail

# Install the tools declared in ~/.config/mise/config.toml.
# Runs in the "after" phase (once the config file has been applied) and
# re-runs whenever the mise config changes, via the hash below.
#
# mise config sha256: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

if ! command -v mise >/dev/null 2>&1; then
    echo "mise not installed; skipping tool install."
    exit 0
fi

echo "==> Installing mise tools (mise install)"
mise install

# qmd bundles better-sqlite3 12.10.0, which predates better-sqlite3's move to
# N-API (13.0.0) and crashes intermittently under our pinned node's (24) newer
# V8 internals (RemoveEnvironmentCleanupHook assertion, confirmed reproducible
# under load). qmd is run under node 22 instead (see the qmd.fish function),
# whose ABI matches what better-sqlite3 12.x actually supports — so build the
# binding against node 22 here too, not whatever mise's npm backend used.
if qmd_dir=$(mise where npm:@tobilu/qmd 2>/dev/null); then
    bsqlite_dir="${qmd_dir}/node_modules/.mise/node_modules/better-sqlite3"
    if [ -d "${bsqlite_dir}" ] && ! mise exec node@22 -- node -e "require('${bsqlite_dir}')" >/dev/null 2>&1; then
        echo "==> Rebuilding better-sqlite3 native binding for qmd (node 22)"
        (cd "${bsqlite_dir}" && mise exec node@22 -- npx --yes node-gyp rebuild --release)
    fi
fi
