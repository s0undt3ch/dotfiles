#!/usr/bin/env bash
# vim: set ft=sh:
set -euo pipefail

# Install herdr-lazy (the declarative plugin manager) and converge herdr's
# plugins to ~/.config/herdr/plugins/config/herdr-lazy/plugins.list.
# Runs in the "after" phase (once all files, including plugins.list, have
# been applied) and re-runs whenever that list changes, via the hash below.
#
# plugins.list sha256: {{ include "dot_config/herdr/plugins/config/herdr-lazy/plugins.list.tmpl" | sha256sum }}
{{ if .work -}}
#
# Also link the local startup-layout plugin, which applies the
# herdr-spreader project layout on server start (see herdr-spreader in
# plugins.list above). Re-runs when either file changes, via the hashes
# below.
# startup-layout manifest sha256: {{ include "dot_config/herdr/plugins/local/startup-layout/herdr-plugin.toml.tmpl" | sha256sum }}
# herdr-spreader config sha256: {{ include "dot_config/herdr/plugins/config/herdr-spreader/config.yaml.tmpl" | sha256sum }}
{{ end -}}

# chezmoi's script shell doesn't activate mise, so mise-managed tools like
# herdr aren't on PATH here even though the mise-tools script just installed
# them. Resolve herdr through mise and put it on PATH before the checks below.
if ! command -v herdr >/dev/null 2>&1 && command -v mise >/dev/null 2>&1; then
    herdr_bin=$(mise which herdr 2>/dev/null || true)
    if [ -n "${herdr_bin}" ]; then
        PATH="$(dirname "${herdr_bin}"):${PATH}"
    fi
fi

if ! command -v herdr >/dev/null 2>&1; then
    echo "herdr not installed; skipping plugin sync."
    exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "jq not installed; skipping plugin sync."
    exit 0
fi

if ! herdr plugin list --json 2>/dev/null | jq -e '.result.plugins[] | select(.plugin_id == "herdr-lazy")' >/dev/null; then
    echo "==> Installing herdr-lazy plugin manager"
    herdr plugin install natori-hrj/herdr-lazy -y
fi

plugin_root=$(herdr plugin list --json | jq -r '.result.plugins[] | select(.plugin_id == "herdr-lazy") | .plugin_root')

if [ ! -x "${plugin_root}/target/release/herdr-lazy" ]; then
    echo "herdr-lazy binary not built yet; skipping plugin sync." >&2
    exit 0
fi

echo "==> Syncing herdr plugins (herdr-lazy sync)"
HERDR_BIN_PATH=$(command -v herdr) "${plugin_root}/target/release/herdr-lazy" sync

{{ if .work -}}
startup_layout_dir="{{ .chezmoi.homeDir }}/.config/herdr/plugins/local/startup-layout"
if ! herdr plugin list --json | jq -e '.result.plugins[] | select(.plugin_id == "startup-layout")' >/dev/null; then
    echo "==> Linking startup-layout plugin"
    herdr plugin link "${startup_layout_dir}"
fi
{{ end -}}
