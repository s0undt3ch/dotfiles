# vim: set ft=toml:

[tools]
  "github:abhinav/git-spice" = "0.31.2"
  "pipx:mempalace"           = "3.6.0"
  usage                      = "4.1.0"

  python                  = "3.11"
  uv                      = "0.12.0"
  github-cli              = "2.96.0"
  aqua                    = "2.62.2"
  semgrep                 = "1.172.0"
  "aqua:s0undt3ch/ToolR"  = "0.26.0"
  bun                     = "1.3.14"
  "aqua:quarylabs/sqruff" = "0.39.0"
  jq                      = "1.8.2"

  # Node 22+ is required by qmd below. GOTCHA: qmd bundles better-sqlite3, a
  # native addon compiled against a specific Node ABI, and mise's npm backend
  # does NOT rebuild npm: tools when node changes — so bumping this pin silently
  # breaks qmd and its MCP server with "Could not locate the bindings file".
  # After any node bump:
  #
  #   mise uninstall npm:@tobilu/qmd --all && mise install npm:@tobilu/qmd
  #
  node                         = "24"
  "npm:@tobilu/qmd"            = "2.5.3"
  "aqua:quarto-dev/quarto-cli" = "1.10.18"
  herdr                        = "0.7.5"

  # llmtrim CLI, required by the llmtrim-herdr plugin (herdr-lazy plugins.list).
  "npm:@llmtrim/cli" = "0.12.1"
{{ if eq .chezmoi.os "darwin" -}}

  # Work-only (Paddle).
  aws                     = "2.36.13"
  "pipx:snowflake-cli"    = "3.23.0"
  "npm:@dust-tt/dust-cli" = "0.4.5"
{{ end -}}

[settings]
  python.uv_venv_auto                 = true
  python.uv_venv_create_args          = ['--seed']
  python.compile                      = false
  experimental                        = true
  idiomatic_version_file_enable_tools = ["python"]

[env]
  _.file = [{ path = "~/.env" }, { path = "~/.env.secrets", redact = true }]
