# vim: set ft=toml:

[tools]
  "github:abhinav/git-spice" = "0.31.2"
  "pipx:mempalace"           = "3.8.0"
  usage                      = "6.4.0"

  python                  = "3.14"
  uv                      = "0.12.5"
  github-cli              = "2.98.0"
  aqua                    = "2.62.3"
  semgrep                 = "1.174.0"
  "aqua:s0undt3ch/ToolR"  = "0.32.0"
  bun                     = "1.4.0"
  "aqua:quarylabs/sqruff" = "0.40.0"
  jq                      = "1.8.2"

  # qmd bundles better-sqlite3 12.10.0 (pre-N-API), which crashes under this
  # node's V8 internals under load. qmd always runs under node 22 instead —
  # see the qmd fish function (conf.d/qmd.fish) and the better-sqlite3 rebuild
  # step in .chezmoiscripts/run_onchange_after_install_mise_tools.sh.tmpl —
  # so bumping this pin does not affect qmd.
  node                         = "26"
  "npm:@tobilu/qmd"            = "2.8.3"
  "aqua:quarto-dev/quarto-cli" = "1.10.18"
  herdr                        = "0.8.2"

  # llmtrim CLI, required by the llmtrim-herdr plugin (herdr-lazy plugins.list).
  # Prebuilt Rust binary from GitHub releases — avoids the npm/Node wrapper.
  # On linux x86_64 the release ships two candidate assets (plain musl CLI and a
  # gnu "tray" GUI build); pin matching=musl so ubi/github doesn't grab the tray one.
{{- if eq .chezmoi.os "darwin" }}
  "github:fkiene/llmtrim[exe=llmtrim]" = "0.13.2"
{{- else }}
  "github:fkiene/llmtrim[matching=musl,exe=llmtrim]" = "0.13.2"
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}

  # Work-only (Paddle).
  aws                     = { version = "2.36.31", symlink_bins = "true" }
  "pipx:snowflake-cli"    = "3.25.0"
  "npm:@dust-tt/dust-cli" = "0.4.5"
{{ end -}}

[settings]
  python.uv_venv_auto                 = true
  python.uv_venv_create_args          = ['--seed']
  python.compile                      = false
  experimental                        = true
  idiomatic_version_file_enable_tools = ["python"]

[env]
  _.file = [{ path = "~/.env" }, { path = "~/.env.secrets", redact = true }]
