# vim: set ft=toml:

[tools]
  "github:abhinav/git-spice" = "0.32.0"
  "pipx:mempalace"           = "3.11.0"
  usage                      = "7.0.0"

  python                  = "3.14.8"
  uv                      = "0.13.1"
  github-cli              = "2.102.0"
  aqua                    = "2.64.0"
  semgrep                 = "1.180.0"
  "aqua:s0undt3ch/ToolR"   = "0.34.1"
  "aqua:redhat-et/ripwire" = "0.6.7"
  bun                      = "1.4.3"
  "aqua:quarylabs/sqruff"  = "0.41.0"
  jq                       = "1.8.2"

  node                         = "26.12.0"
  "aqua:quarto-dev/quarto-cli" = "1.10.19"
  herdr                        = "0.9.4"
  vale                         = "3.24.0"

  # llmtrim CLI, required by the llmtrim-herdr plugin (herdr-lazy plugins.list).
  # Prebuilt Rust binary from GitHub releases — avoids the npm/Node wrapper.
  # On linux x86_64 the release ships two candidate assets (plain musl CLI and a
  # gnu "tray" GUI build); pin matching=musl so ubi/github doesn't grab the tray one.
{{- if eq .chezmoi.os "darwin" }}
  "github:fkiene/llmtrim[exe=llmtrim]" = "0.13.7"
{{- else }}
  "github:fkiene/llmtrim[matching=musl,exe=llmtrim]" = "0.13.7"
{{- end }}

  # MemPalace vector store, run as a user service (qdrant launchd/systemd unit).
  # Linux x86_64 ships gnu and musl tarballs; pin gnu so the pick is stable.
{{- if eq .chezmoi.os "darwin" }}
  "github:qdrant/qdrant" = "1.19.2"
{{- else }}
  "github:qdrant/qdrant[matching=linux-gnu]" = "1.19.2"
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}

  # Work-only (Paddle).
  aws                     = { version = "2.38.1", symlink_bins = "true" }
  "pipx:snowflake-cli"    = "3.29.0"
  "npm:@dust-tt/dust-cli" = "0.4.6"
{{ end -}}

[settings]
  python.uv_venv_auto                 = true
  python.uv_venv_create_args          = ['--seed']
  python.compile                      = false
  experimental                        = true
  idiomatic_version_file_enable_tools = ["python"]

[env]
  _.file = [{ path = "~/.env" }, { path = "~/.env.secrets", redact = true }]
