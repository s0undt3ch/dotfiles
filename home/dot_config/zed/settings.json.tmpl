// vim: set ft=jsonc:
//
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "context_servers": {
{{- if eq .chezmoi.os "darwin" }}
    "mcp-server-linear": {
      "enabled": true,
      "remote": false,
      "settings": {}
    },
    "mcp-server-grafana": {
      "enabled": true,
      "remote": false,
      "settings": {}
    },
{{- end }}
    "mcp-server-github": {
      "enabled": true,
      "settings": {}
    }
  },
  "buffer_font_fallbacks": ["Menlo", "Monaco", "Courier New", "monospace"],
  "buffer_font_family": "SauceCodePro Nerd Font",
  "buffer_font_size": 16,
  "buffer_line_height": {"custom": 1.6},
  "buffer_font_features": {"calt": false},
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
  },
  "ui_font_size": 16,
  "ui_font_family": ".SystemUIFont",
  "theme": "One Dark Pro Darker",
  "icon_theme": "Catppuccin Mocha",
  "vim_mode": true,
  "tabs": {
    "file_icons": true,
  },
  "show_wrap_guides": true,
  "tab_size": 2,
  "hard_tabs": false,
  "format_on_save": "off",
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4"
    },
    "model_parameters": []
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
  },
  "languages": {
    "Python": {
      "tab_size": 4,
      "hard_tabs": false,
      "soft_wrap": "none",
      "preferred_line_length": 120
    }
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "relative_line_numbers": "enabled",
  "auto_install_extensions": {
    "git-firefly": true,
    "ruff": true,
    "toml": true,
    "one-dark-pro-enhanced": true,
    "python-requirements": true,
    "python-snippets": true,
    "material-icon-theme": true
  },
  "notification_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "hide_hidden": false,
    "dock": "left",
    "hide_gitignore": true
  },
  "terminal": {
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default"
      }
    }
  }
}
