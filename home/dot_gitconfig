[includeIf "gitdir:~/projects/me/**"]
  path = .gitconfig.personal
[includeIf "gitdir:~/projects/paddle/**"]
  path = .gitconfig.work
[user]
	email = pedro@algarvio.me
  name = Pedro Algarvio
  signingkey = BB36BF6584A298FF
[commit]
  gpgsign = true
[log]
	decorate = full
[alias]
	l = log --oneline --decorate
	ll = log --stat --decorate --abbrev-commit --date=relative
	lll = log -p --stat --decorate --abbrev-commit --date=relative
	llll = "!sh -c 'git lll $@ \
		| gvim - -R -v -c \"set ft=git\" -c \"set fdm=syntax\"' -"
