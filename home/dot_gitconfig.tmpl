# vim: set ft=gitconfig:

[includeIf "gitdir:~/projects/me/**"]
  path = .gitconfig.personal
{{ if eq .chezmoi.os "darwin" -}}
[includeIf "gitdir:~/projects/paddle/**"]
  path = .gitconfig.paddle
{{ else -}}
[includeIf "gitdir:~/projects/work/**"]
  path = .gitconfig.work
{{ end -}}
[user]
	email = pedro@algarvio.me
  name = Pedro Algarvio
  signingkey = BB36BF6584A298FF
[commit]
  gpgsign = true
[spice "branchCreate"]
  # Don't create an empty commit when a new stacked branch has no staged changes.
  commit = false
[log]
	decorate = full
[alias]
	l = log --oneline --decorate
	ll = log --stat --decorate --abbrev-commit --date=relative
	lll = log -p --stat --decorate --abbrev-commit --date=relative
	llll = "!sh -c 'git lll $@ \
		| gvim - -R -v -c \"set ft=git\" -c \"set fdm=syntax\"' -"
