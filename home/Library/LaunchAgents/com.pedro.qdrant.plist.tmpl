<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.pedro.qdrant</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.local/share/mise/shims/qdrant</string>
		<string>--config-path</string>
		<string>{{ .chezmoi.homeDir }}/.config/qdrant/config.yaml</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{ .chezmoi.homeDir }}/.local/share/qdrant</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/qdrant.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/qdrant.log</string>
</dict>
</plist>
